# Supabase project (the shared one used by Remindurr / WatchTracker)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx

# Storage bucket name for job photos (create this bucket in Supabase, private)
SUPABASE_STORAGE_BUCKET=diy-tracker-photos

# Simple PIN gate for the whole site
SITE_PIN=change-me
SITE_SESSION_SECRET=replace-with-a-long-random-string
